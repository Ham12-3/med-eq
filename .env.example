# Copy to .env.local. These match docker-compose.yml and are for local development only.

# App and seed connect as the restricted role (no DELETE, audit_log is insert-only).
DATABASE_URL=postgres://medasset_app:medasset_app_dev@localhost:5432/medasset
# Migrations and db:reset connect as the owner.
DATABASE_OWNER_URL=postgres://medasset:medasset_dev@localhost:5432/medasset

# Vitest uses a separate database, reset and seeded before each run.
TEST_DATABASE_URL=postgres://medasset_app:medasset_app_dev@localhost:5432/medasset_test
TEST_DATABASE_OWNER_URL=postgres://medasset:medasset_dev@localhost:5432/medasset_test

# Auth.js. Generate a secret per machine: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me
# "Sign in as" any seeded user without a password. Development only; ignored in production builds.
AUTH_DEV_LOGIN=true
